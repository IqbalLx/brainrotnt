{
  "name": "bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/bridge",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@brainrotnt/math-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "yaml": "^2.9.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "@types/bun": "^1.1.14"
  }
}
